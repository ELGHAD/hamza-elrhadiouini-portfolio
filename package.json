{
  "name": "portfolio",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "generated:files": "node scripts/write-emailjs-env.mjs --if-missing && node scripts/write-build-info.mjs",
    "prestart": "npm run generated:files",
    "start": "ng serve",
    "prebuild": "npm run generated:files",
    "build": "ng build",
    "postbuild": "node scripts/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generated:files",
    "test": "ng test",
    "env:emailjs": "node scripts/write-emailjs-env.mjs",
    "generate:images": "node scripts/generate-images.mjs",
    "check:content": "node --experimental-strip-types scripts/check-content.ts",
    "content:report": "node --experimental-strip-types scripts/check-content.ts --report"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-server": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/ssr": "^21.2.26",
    "@emailjs/browser": "^4.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
